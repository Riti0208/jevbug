# Server-side only (Vercel project env vars). Never expose to the browser.
# Vercel AI Gateway API key: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai%2Fapi-keys
AI_GATEWAY_API_KEY=
# Optional: Jev model id on the gateway (default: typesafe-ai/jev-latest)
JEV_MODEL=typesafe-ai/jev-latest
# Optional: call TypeSafe directly instead of the gateway (JEV_BACKEND=typesafe)
JEV_BACKEND=gateway
TYPESAFE_API_KEY=
